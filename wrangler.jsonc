{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calice",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "calice-db", "database_id": "01336527-aa78-4967-909e-eb423784c90d" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "calice-photos" }
  ],
  "ai": { "binding": "AI" },
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "vars": {
    "ACCESS_TEAM": "smartcores",
    "ACCESS_AUD": "76e9740eac8450d98dc640b497ed23e69390ea323334299cbcaa072f195c9e2c"
  },
  "routes": [
    { "pattern": "calice.smartcores.org", "custom_domain": true }
  ],
  "workers_dev": false
}
