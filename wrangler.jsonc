{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calice",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "calice-db", "database_id": "01336527-aa78-4967-909e-eb423784c90d" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "calice-photos" }
  ],
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  // ACCESS_AUD: fill in once the "Calice" Access Application exists in
  // Zero Trust (dash.cloudflare.com -> Zero Trust -> Access -> Applications
  // -> Calice -> Overview -> Application Audience (AUD) Tag).
  "vars": {
    "ACCESS_TEAM": "smartcores",
    "ACCESS_AUD": "TODO-fill-in-after-creating-the-Access-app"
  },
  "routes": [
    { "pattern": "calice.smartcores.org", "custom_domain": true }
  ],
  "workers_dev": false
}
