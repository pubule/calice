{
  // Test-only: vitest-pool-workers (worker/vitest.config.ts) uses this file
  // for local D1/R2 bindings. Production deploys from the root wrangler.jsonc,
  // which merges this Hono app with the static frontend into one Worker
  // behind Cloudflare Access.
  "name": "calice-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "calice-db", "database_id": "01336527-aa78-4967-909e-eb423784c90d" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "calice-photos" }
  ],
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "vars": {
    "ACCESS_TEAM": "smartcores",
    "ACCESS_AUD": "test-aud"
  }
}
